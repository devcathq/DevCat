{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevCat",
  "mainBinaryName": "devcat-mobile",
  "version": "0.8.1",
  "identifier": "dev.devcat.mobile",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm mobile:dev",
      "cwd": "../.."
    },
    "devUrl": "http://localhost:1440",
    "beforeBuildCommand": {
      "script": "pnpm mobile:build",
      "cwd": "../.."
    },
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DevCat Mobile",
        "width": 400,
        "height": 860,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Control DevCat on your computer from your phone",
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "android": {
      "minSdkVersion": 26
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "devcat"
          ],
          "appLink": false
        }
      ],
      "desktop": {
        "schemes": [
          "devcat"
        ]
      }
    }
  }
}

{
  "name": "devcat-film",
  "private": true,
  "type": "module",
  "description": "DevCat's README tour and social video, made with HyperFrames (HTML + GSAP \u2192 MP4).",
  "scripts": {
    "preview": "npx --yes hyperframes@0.8.221 preview",
    "check": "npx --yes hyperframes@0.8.221 check",
    "social": "npx --yes hyperframes@0.8.221 render -o out/devcat-social.mp4",
    "readme": "npx --yes hyperframes@0.8.221 render -c ./readme.html -o out/devcat-readme.mp4"
  }
}

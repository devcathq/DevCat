{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevCat",
  "version": "0.8.0",
  "identifier": "dev.devcat.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DevCat",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false,
        "transparent": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Database, Kubernetes and RabbitMQ client",
    "longDescription": "DevCat is a cross-platform developer workbench for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB, Redis, Kubernetes and RabbitMQ.",
    "copyright": "",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": [
          "ovpn"
        ],
        "name": "OpenVPN profile",
        "description": "OpenVPN profile",
        "role": "Viewer",
        "mimeType": "application/x-openvpn-profile"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVEQUYxQjU4OEM0REI1QzYKUldUR3RVMk1XQnV2N2R1OUZXOC84UXVsZ2cyNE9RNU9lUkhmaFBOazd2TzcwZXNvYjB6WDZMaHIK",
      "endpoints": [
        "https://github.com/devcathq/DevCat/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

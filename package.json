{
  "name": "devcat",
  "private": true,
  "version": "0.10.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && pnpm mobile:web",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:bridge": "vite --mode bridge --port 1425",
    "dev:demo": "vite --mode demo --port 1426",
    "mobile:dev": "vite --config mobile/vite.config.ts",
    "mobile:build": "tsc -p mobile && vite build --config mobile/vite.config.ts",
    "mobile:bridge": "vite --config mobile/vite.config.ts --mode bridge --port 1442",
    "mobile:web": "tsc -p mobile && vite build --config mobile/vite.config.ts --mode web",
    "mobile:hosted": "tsc -p mobile && vite build --config mobile/vite.config.ts --mode hosted",
    "mobile:check-crypto": "node --experimental-strip-types mobile/src/web/crypto.check.ts",
    "check:tree": "node --experimental-strip-types src/features/connections/tree/rows.check.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/dejavu-mono": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.17",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-barcode-scanner": "^2.5.3",
    "@tauri-apps/plugin-deep-link": "^2.6.2",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "@tauri-apps/plugin-fs": "^2.7.0",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode-graphemes": "^0.4.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "jsqr": "1.4.0",
    "loro-crdt": "1.16.2",
    "lucide-react": "^1.56.0",
    "monaco-editor": "^0.57.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.5",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
